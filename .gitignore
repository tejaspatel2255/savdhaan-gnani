# ── Environment variables and secrets (CRITICAL: NEVER COMMIT) ────────────────
.env
.env*.local
.env.*
*.env
*.env.*
*.env.bak
*.env.save
!.env.example

# Credentials, tokens, and private keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*token*.json
*token*.txt
*credential*.json
service_account*.json
service-account*.json
client_secret*.json
client_secrets*.json
.netrc
.npmrc

# Cloud deployment CLI metadata & local caches
.vercel/
.render/
.aws/
.gcloud/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# ── Runtime data (never commit) ─────────────────────────────────────────────
data/usage_ledger.json

# API response cache (STT / TTS) – can be large, regenerated automatically
data/cache/stt/
data/cache/tts/
data/cache/warnings/
data/cache/*.wav
data/cache/*.json

# Live session run logs
data/runs/*.jsonl
!data/runs/.gitkeep

# Eval run log (raw per-run data; results.json is committed, run log is not)
data/eval/test_runs.jsonl
data/eval/dev_runs.jsonl

# ── Audio files (synthetic recordings) ──────────────────────────────────────
# Keep data/cache/.gitkeep and data/calls/.gitkeep, ignore audio blobs
data/calls/*.wav
data/calls/*.pcm
data/calls/*.mp3
data/calls/*.ogg
data/calls/*.flac

# Global wav/pcm catch-all (smoke test outputs, tmp recordings)
*.pcm
test_call_tmp/
test_tmp/
tmp_test_dir/

# Commit static hosted assets
!frontend/assets/audio/*.wav
!frontend/assets/results.json

# ── Editor and OS files ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
.DS_Store
Thumbs.db
ehthumbs.db

# ── Logs and scratch ─────────────────────────────────────────────────────────
*.log
scratch/
