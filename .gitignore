# Environment variables and secrets (CRITICAL: NEVER COMMIT)
.env
.env*.local
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# ── Runtime data (never commit) ─────────────────────────────────────────────

# API response cache (STT / TTS) – can be large, regenerated automatically
data/cache/stt/
data/cache/tts/
data/cache/warnings/
data/cache/*.wav
data/cache/*.json

# Live session run logs
data/runs/*.jsonl
!data/runs/.gitkeep

# Eval run log (raw per-run data; results.json is committed, run log is not)
data/eval/test_runs.jsonl
data/eval/dev_runs.jsonl

# ── Audio files (synthetic recordings) ──────────────────────────────────────
# Keep data/cache/.gitkeep and data/calls/.gitkeep, ignore audio blobs
data/calls/*.wav
data/calls/*.pcm
data/calls/*.mp3
data/calls/*.ogg
data/calls/*.flac

# Global wav/pcm catch-all (smoke test outputs, tmp recordings)
*.pcm
test_call_tmp/
test_tmp/
tmp_test_dir/

# ── Editor and OS files ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# ── Logs and scratch ─────────────────────────────────────────────────────────
*.log
scratch/
