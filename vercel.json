{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://savdhaan-gnani.onrender.com/api/$1"
    }
  ]
}
